# Generate a secret: uv run python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Install as /etc/pysync/server.env, owner root, mode 0600.
PYSYNC_SERVER_OWNER_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_24_CHARACTERS
PYSYNC_SERVER_DATA_DIR=/var/lib/pysync
PYSYNC_SERVER_HOST=127.0.0.1
PYSYNC_SERVER_PORT=8000
PYSYNC_SERVER_MAX_FILE_SIZE=104857600
PYSYNC_SERVER_MAX_STORAGE_SIZE=21474836480
PYSYNC_SERVER_MAX_UPLOADS=4
PYSYNC_SERVER_UPLOAD_TIMEOUT=300
# Optional direct TLS (otherwise terminate TLS using a private VPN reverse proxy):
# PYSYNC_SERVER_TLS_CERT=/etc/pysync/server.crt
# PYSYNC_SERVER_TLS_KEY=/etc/pysync/server.key
